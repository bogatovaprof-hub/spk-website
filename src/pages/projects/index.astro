---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/InnerHero.astro';
import CallToAction from '../../components/CallToAction.astro';
import pages from '../../data/pages.json';
import projects from '../../data/projects.json';
import { withBase } from '../../lib/urls';

const page = pages.projects;
---

<BaseLayout title="Проекты — СПК ТРЕЙД" description={page.description} activeSection="projects">
  <InnerHero title={page.h1} description={page.description} />
  <section class="container content-section" aria-label="Объекты, в работах на которых участвовала команда">
    <div class="projects-grid">
      {projects.map((project) => (
        <article class="project-card">
          <picture class="project-card-media" aria-hidden="true">
            <source srcset={withBase(`/images/${project.image}.webp`)} type="image/webp" />
            <img
              src={withBase(`/images/${project.image}.jpg`)}
              width={project.imageWidth}
              height={project.imageHeight}
              class:list={{
                'project-photo-collage': project.image === 'projects/nizhegorodskie-sorbenty',
                'project-photo-left': ['projects/globus', 'projects/lenta'].includes(project.image)
              }}
              alt=""
              loading="lazy"
            />
          </picture>
          <div class="project-card-content">
            <p class="project-kicker">Проект</p>
            <h2>{project.title}</h2>
            {project.location && <p class="project-location">{project.location}</p>}
            {project.work && <p class="project-work">{project.work}</p>}
          </div>
        </article>
      ))}
    </div>
    <p class="projects-visual-note">
      Фотографии объектов предоставлены заказчиком.
    </p>
  </section>
  <CallToAction secondaryLabel={page.primaryCta} />
</BaseLayout>
