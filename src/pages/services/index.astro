---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/InnerHero.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import Directions from '../../components/Directions.astro';
import CallToAction from '../../components/CallToAction.astro';
import services from '../../data/services.json';
import pages from '../../data/pages.json';
---

<BaseLayout title="Услуги — СПК ТРЕЙД" description={pages.services.description} activeSection="services">
  <InnerHero title={pages.services.h1} description={pages.services.description} />
  <section class="container content-section" aria-labelledby="services-catalog-title">
    <h2 id="services-catalog-title">Наши услуги</h2>
    <ServicesGrid cards={services} showDescriptions className="catalog-grid" />
  </section>
  <Directions />
  <CallToAction />
</BaseLayout>
