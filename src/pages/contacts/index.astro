---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/InnerHero.astro';
import pages from '../../data/pages.json';
import site from '../../data/site.json';

const mapUrl = 'https://yandex.ru/map-widget/v1/?ll=43.977167%2C56.324428&mode=search&oid=1071296582&ol=biz&z=15';
const routeUrl = 'https://yandex.ru/maps/47/nizhny-novgorod/?ll=43.977167%2C56.324428&z=15';
---

<BaseLayout title="Контакты — СПК ТРЕЙД" description={pages.contacts.unconfirmedText} activeSection="contacts">
  <InnerHero title={pages.contacts.h1} description={pages.contacts.unconfirmedText} />
  <section class="container content-section contacts-layout">
    <div class="contact-card contact-card-stacked">
      <h2>{pages.contacts.companyLabel}</h2>
      <dl class="contact-list">
        <div><dt>{pages.contacts.phoneLabel}</dt><dd>{site.contacts.phoneDisplay}</dd></div>
        <div><dt>{pages.contacts.emailLabel}</dt><dd>{site.contacts.emailDisplay}</dd></div>
        <div><dt>{pages.contacts.addressLabel}</dt><dd>{pages.contacts.addressDisplay}</dd></div>
      </dl>
      <button class="button button-primary" type="button" data-dialog-open>{pages.contacts.primaryCta}</button>
    </div>
    <div class="map-card">
      <iframe
        src={mapUrl}
        title={pages.contacts.mapTitle}
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <div class="map-card-footer">
        <div>
          <strong>{pages.contacts.mapLabel}</strong>
          <span>{pages.contacts.addressDisplay}</span>
        </div>
        <a class="button button-secondary" href={routeUrl} target="_blank" rel="noopener noreferrer">
          {pages.contacts.routeCta}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

