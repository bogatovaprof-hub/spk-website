---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/InnerHero.astro';
import CallToAction from '../../components/CallToAction.astro';
import about from '../../data/about.json';
---

<BaseLayout title={`${about.h1} — СПК ТРЕЙД`} description={about.intro} activeSection="about" bodyClass="about-page">
  <InnerHero title={about.h1} description={about.intro} image={about.image} />
  <section class="container content-section about-content-grid">
    <div class="prose">
      <h2>О работе компании</h2>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <p><strong>{about.consultation}</strong></p>
    </div>
    <aside class="info-card">
      <h2>Основания и преимущества</h2>
      <ul class="plain-list">{about.facts.map((fact) => <li>{fact}</li>)}</ul>
    </aside>
    <aside class="info-card">
      <h2>Наш подход</h2>
      <ul class="plain-list">{about.advantages.map((advantage) => <li>{advantage}</li>)}</ul>
    </aside>
  </section>
  <CallToAction />
</BaseLayout>
